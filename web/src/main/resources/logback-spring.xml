<configuration>
    <!-- 核心修改1：服务器端强制指定日志路径为 jar 包同级 logs 目录 -->
    <!-- 本地：${user.home}/fastcms/logs；服务器：启动命令通过 -log.path 覆盖为目标目录 -->
    <springProperty scope="context" name="logPath" source="log.path" defaultValue="${user.home}/fastcms/logs"/>
    <property name="LOG_HOME" value="${logPath}"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 控制台输出（所有环境都保留） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件输出（所有环境都保留） -->
    <appender name="rootFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/fastcms1111.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/fastcms.log.%d{yyyy-MM-dd}.%i</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>15</maxHistory>
            <totalSizeCap>512MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <Pattern>%date %level [%thread] %logger{50} - %msg%n</Pattern> <!-- 补充线程/类名，方便排查 -->
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- dev 环境：控制台+文件都输出，级别 DEBUG -->
    <springProfile name="dev">
        <logger name="org.springframework" level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/> <!-- 新增文件输出 -->
        </logger>
        <logger name="org.apache.catalina.startup.DigesterFactory" level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.apache.catalina.util.LifecycleBase" level="ERROR">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.apache.coyote.http11.Http11NioProtocol" level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.apache.tomcat.util.net.NioSelectorPool" level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.apache.ibatis" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="com.baomidou.mybatisplus" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.mybatis.spring" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.pf4j" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="com.fastcms" level="DEBUG"> <!-- dev 保留 DEBUG，方便调试 -->
            <appender-ref ref="CONSOLE"/> <!-- 保留控制台 -->
            <appender-ref ref="rootFile"/> <!-- 新增文件输出 -->
        </logger>
        <logger name="freemarker.template" level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
    </springProfile>

    <!-- prod 环境：控制台+文件都输出，级别 INFO -->
    <springProfile name="prod">
        <logger name="org.springframework.boot.web.embedded.tomcat" level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="com.fastcms.web.Fastcms" level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.apache.catalina.startup.DigesterFactory" level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.apache.catalina.util.LifecycleBase" level="ERROR">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.apache.coyote.http11.Http11NioProtocol" level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.apache.tomcat.util.net.NioSelectorPool" level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.springframework.security.oauth2" level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.apache.ibatis" level="ERROR">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="com.baomidou.mybatisplus" level="ERROR">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="org.mybatis.spring" level="ERROR">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="rootFile"/>
        </logger>
        <logger name="com.fastcms" level="INFO">
            <appender-ref ref="CONSOLE"/> <!-- 新增控制台输出，方便排查 -->
            <appender-ref ref="rootFile"/>
        </logger>
    </springProfile>

    <!-- 核心修改2：root 节点绑定控制台+文件，确保所有日志都有输出 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="rootFile"/>
    </root>

</configuration>